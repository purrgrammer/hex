<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The runtime half. Load this one FIRST: the gateway survives it being absent,
  but a runtime that is not there answers nobody.

  Replace HEX_DIR and NODE_BIN before loading. Nothing here is installed by the
  package; see docs/operating.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>rocks.grimoire.hex.runtime</string>

  <key>ProgramArguments</key>
  <array>
    <string>NODE_BIN</string>
    <string>HEX_DIR/node_modules/.bin/eve</string>
    <string>dev</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <!-- Always: a runtime that exits cleanly has still stopped answering. This is
       the opposite of the gateway, where a clean exit is somebody stopping it. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>WorkingDirectory</key>
  <string>HEX_DIR</string>

  <key>StandardOutPath</key>
  <string>HEX_DIR/eve.out.log</string>
  <key>StandardErrorPath</key>
  <string>HEX_DIR/eve.out.log</string>
</dict>
</plist>
