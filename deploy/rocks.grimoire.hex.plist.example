<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>rocks.grimoire.hex</string>

  <!-- Follows ONE Eve session and publishes it. The session id is an argument,
       so this is a per-session job rather than a daemon: `hex run` is gone, the
       agent loop lives in Eve now, and nothing here decides when a session
       starts. Copy it per session, or drive `hex eve` from whatever launches
       Eve.

       caffeinate holds sleep off for as long as it runs, and exits with it, so
       no assertion is left behind when the follow stops. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>-s</string>
    <string>/Users/YOU/.nvm/versions/node/v26.3.1/bin/node</string>

    <!-- An installed copy, NOT a path inside a git worktree.
         `npm run build -w nostr-hex && cp -R packages/hex/dist ~/.hex/dist`
         A plist pointing into `.claude/worktrees/…` makes that worktree
         load-bearing: deleting the branch you were developing on stops the
         agent, and a rebuild mid-conversation swaps the code underneath it. -->
    <string>/Users/YOU/.hex/dist/cli.js</string>
    <string>eve</string>
    <string>/Users/YOU/.hex/hex.config.json</string>
    <string>ses_REPLACE_WITH_SESSION_ID</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart on crash, and only on crash: a clean exit is a deliberate stop.
       Safe to restart because the stream cursor is durable — a resumed follow
       asks Eve for the events it missed rather than republishing the session. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- The agent's own directory, so nothing it does depends on a checkout. -->
  <key>WorkingDirectory</key>
  <string>/Users/YOU/.hex</string>

  <!-- launchd hands a process a minimal PATH and no login shell, so a version
       manager is not on it. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOU/.nvm/versions/node/v26.3.1/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/YOU/.hex/hex.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/.hex/hex.err.log</string>
</dict>
</plist>
