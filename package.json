{
  "name": "nostr-hex",
  "version": "0.1.0",
  "description": "Hex — a transport-agnostic agent for Nostr groups. NIP-29 today, NIP-17 and Concord next.",
  "type": "module",
  "license": "MIT",
  "author": "Alejandro Gómez",
  "keywords": [
    "nostr",
    "agent",
    "bot",
    "nip-29",
    "nip-17"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hex": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "instructions.md",
    "hex.config.example.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "applesauce-common": "^6.2.0",
    "applesauce-core": "^6.2.0",
    "applesauce-relay": "^6.2.1",
    "applesauce-signers": "^6.2.2",
    "nostr-tools": "~2.19",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "fast-check": "^3.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purrgrammer/hex.git"
  },
  "homepage": "https://github.com/purrgrammer/hex",
  "bugs": {
    "url": "https://github.com/purrgrammer/hex/issues"
  }
}
