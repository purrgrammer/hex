{
  "identity": { "signer": { "type": "nsec", "env": "HEX_NSEC" } },
  "instructions": "./instructions.md",
  "mentions": ["hex", "@hex"],
  "brain": {
    "type": "openai-compatible",
    "baseUrl": "https://example.invalid/v1",
    "model": "your-model",
    "apiKeyEnv": "HEX_API_KEY",
    "maxSteps": 40
  },
  "relays": {
    "read": ["wss://relay.example.invalid"],
    "publish": ["wss://relay.example.invalid"],
    "dm": ["wss://inbox.example.invalid"]
  },
  "profile": {
    "publish": true,
    "bot": true,
    "name": "Hex",
    "about": "The grimoire assistant. Ask me about NIPs, kinds, and how relays actually behave.",
    "picture": "https://i.nostr.build/6BK9LpTI5oFAvlyy.png",
    "nip05": "hex@grimoire.rocks",
    "website": "https://grimoire.rocks"
  },
  "context": { "messages": 40 },
  "state": { "home": "~/.hex", "sessionIdleMinutes": 30 },
  "limits": { "repliesPerRoomPerHour": 20 },
  "repos": [{ "name": "grimoire", "path": "/absolute/path/to/your/clone" }],
  "toolsets": {
    "reader": { "tools": ["grimoire.*", "nostr.*"] },
    "coder": {
      "tools": ["grimoire.*", "nostr.*", "repo.*"],
      "repos": ["grimoire"],
      "isolation": "host-worktree",
      "execTimeoutMinutes": 15
    }
  },
  "transports": [
    {
      "type": "nip-29",
      "autoJoin": false,
      "toolset": "reader",
      "groups": [{ "relay": "wss://groups.example.invalid", "id": "your-group" }]
    },
    {
      "type": "nip-17",
      "allow": [{ "pubkey": "npub1...", "toolset": "coder" }]
    }
  ]
}
