{
  "identity": {
    "signer": {
      "type": "nsec",
      "env": "HEX_NSEC"
    }
  },
  "instructions": "./instructions.md",
  "mentions": ["hex", "@hex"],
  "relays": {
    "read": ["wss://relay.example.invalid"],
    "publish": ["wss://relay.example.invalid"],
    "dm": ["wss://inbox.example.invalid"]
  },
  "profile": {
    "publish": true,
    "bot": true,
    "name": "Hex",
    "about": "The grimoire assistant. Ask me about NIPs, kinds, and how relays actually behave.",
    "picture": "https://i.nostr.build/6BK9LpTI5oFAvlyy.png",
    "nip05": "hex@grimoire.rocks",
    "website": "https://grimoire.rocks"
  },
  "state": {
    "home": "~/.hex"
  },
  "limits": {
    "repliesPerRoomPerHour": 20
  },
  "eve": {
    "host": "http://127.0.0.1:2000"
  },
  "transcript": {
    "to": ["npub1..."],
    "slug": "hex",
    "deltas": true
  },
  "transports": [
    {
      "type": "nip-29",
      "autoJoin": false,
      "groups": [
        {
          "relay": "wss://groups.example.invalid",
          "id": "your-group"
        }
      ]
    },
    {
      "type": "nip-17",
      "allow": [
        {
          "pubkey": "npub1..."
        }
      ]
    }
  ]
